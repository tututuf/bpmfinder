{
  "name": "bpmfinder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "postinstall": "node scripts/prepare-browser-runtime.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "prepare:analysis": "node scripts/prepare-commercial-analysis.mjs",
    "check:upgrade": "node scripts/upgrade-check.mjs",
    "prepare:analysis:legacy": "node scripts/prepare-analysis-assets.mjs",
    "build:cloudflare": "opennextjs-cloudflare build && node scripts/prepare-cloudflare-assets.mjs",
    "preview:cloudflare": "wrangler dev --port 3002",
    "deploy:cloudflare": "npm run build:cloudflare && node scripts/deploy-cloudflare.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "latest",
    "@fontsource/plus-jakarta-sans": "latest",
    "@gsap/react": "2.1.2",
    "@huggingface/transformers": "4.3.2",
    "@tensorflow/tfjs": "4.22.0",
    "@tensorflow/tfjs-backend-wasm": "4.22.0",
    "@waffo/pancake-ts": "0.27.0",
    "gsap": "3.15.0",
    "lucide-react": "latest",
    "next": "latest",
    "next-auth": "4.24.15",
    "react": "latest",
    "react-dom": "latest",
    "resend": "6.35.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261031.1",
    "@opennextjs/cloudflare": "^1.20.15",
    "@playwright/test": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "esbuild": "^0.28.2",
    "essentia.js": "0.1.3",
    "miniflare": "^5.20261023.3-beta",
    "typescript": "latest",
    "wrangler": "^4.156.0"
  }
}
