GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Public canonical origin for metadata and sitemap; independent of local auth URLs.
SITE_URL=https://bpmfder.com
GOOGLE_SITE_VERIFICATION=
RESEND_API_KEY=
RESEND_FROM="BPM Finder <support@bpmfder.com>"
# Persistent local disk required. Use Node.js 24.13+ for node:sqlite.
AUTH_DATABASE_PATH=.data/accounts.sqlite
# Leave unset for local Node.js. Cloudflare sets this in wrangler.jsonc.
STORAGE_BACKEND=
# Set only behind a proxy that overwrites this header (e.g. cf-connecting-ip).
AUTH_TRUSTED_IP_HEADER=

WAFFO_MERCHANT_ID=
WAFFO_STORE_ID=
WAFFO_PRIVATE_KEY=
WAFFO_ENVIRONMENT=prod
WAFFO_MONTHLY_PRODUCT_ID=
WAFFO_YEARLY_PRODUCT_ID=
# Set after deploying this route, then run the setup script with --webhook.
WAFFO_WEBHOOK_URL=
WAFFO_BILLING_ENABLED=false
# Default: original DSP + Apache-2.0 CLAP; legacy is an explicit optional backup.
ANALYSIS_ENGINE=commercial
# Only relevant for ANALYSIS_ENGINE=legacy; records permissions already obtained.
COMMERCIAL_ANALYSIS_LICENSE_CONFIRMED=false
